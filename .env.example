# Copie este arquivo para .env e preencha com os dados de conexão do Aiven.
# Mantenha useSSL=true: o Aiven exige conexão criptografada.
SPRING_DATASOURCE_URL=jdbc:mysql://SEU_HOST_AIVEN:PORTA/encurtador?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_AQUI
